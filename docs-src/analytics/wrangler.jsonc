{
  "name": "ascendmoea-visit-statistics",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "VISITS", "class_name": "VisitCounts" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VisitCounts"] }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "3582044721", "simple": { "limit": 90, "period": 60 } }
  ]
}
